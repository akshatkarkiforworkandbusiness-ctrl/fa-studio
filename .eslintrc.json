{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "react/no-unescaped-entities": "off",
    // Omitting fields via rest destructuring (`const { secret, ...safe } = x`)
    // is intentional; the aliases exist purely to discard them.
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    // The logo assets are small, pre-optimised and next.config sets
    // `images.unoptimized`, so next/image would add cost without benefit.
    "@next/next/no-img-element": "off"
  }
}
