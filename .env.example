# Default SQLite for zero-friction local development:
DATABASE_URL="file:./dev.db"

# For PostgreSQL production (Vercel Postgres / Neon / Supabase), update prisma/schema.prisma provider to "postgresql" and set:
# DATABASE_URL="postgresql://user:password@host:5432/fa_studio?sslmode=require"

# Secret used to sign HTTP-only session cookies (generate with: openssl rand -hex 32)
AUTH_SECRET="replace-with-a-strong-64-char-random-secret"
