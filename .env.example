# Postgres connection string — read by BOTH local development and production.
# prisma/schema.prisma uses provider = "postgresql", so a SQLite file:// path
# will NOT work.
#
# Easiest local setup: create a free Neon database and use the same URL here
# and in Vercel. No local Postgres install, and dev/prod behave identically.
#
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/fa_studio?sslmode=require"
#
# Or point at Postgres you run yourself (Docker, Postgres.app, winget, ...):
#
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/fa_studio"
#
# Create the tables once per database with:  npm run db:push
DATABASE_URL="postgresql://USER:PASSWORD@HOST/fa_studio?sslmode=require"

# REQUIRED. Signs HTTP-only session cookies.
# The placeholder below is rejected in production: the server refuses to sign sessions
# with a publicly-known value. Generate a real one with either:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters when NODE_ENV=production.
AUTH_SECRET="replace-with-a-strong-64-char-random-secret"

# Optional. Canonical site URL used for metadataBase / OpenGraph.
# Defaults to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL="https://fa-studio.example.com"
